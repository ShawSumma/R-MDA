#version 450
#extension GL_EXT_shader_atomic_float : require
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer buf_x {
    float x[];
};
layout(std430, binding = 1) readonly buffer buf_mix {
    float mix[];
};
layout(std430, binding = 2) buffer buf_out {
    float outp[];
};
layout(std430, binding = 3) buffer buf_dx {
    float dx[];
};
layout(std430, binding = 4) buffer buf_dmix {
    float dmix[];
};
layout(std430, binding = 5) readonly buffer buf_carry_in {
    float carry_in[];
};
layout(std430, binding = 6) writeonly buffer buf_carry_out {
    float carry_out[];
};
layout(push_constant) uniform pc {
    uint bt;
    uint d;
    uint seqlen;
    uint op;
    uint blk;
    uint nclean;
    uint cache;
};

bool clean_row(uint row) {
    return row / seqlen < nclean;
}

bool first(uint row) {
    uint t = row % seqlen;
    return t == 0u || (blk > 0u && clean_row(row) == false && t % blk == 0u);
}

float previous(uint row, uint col) {
    if (first(row) && cache == 1u && clean_row(row) && row % seqlen == 0u) {
        return carry_in[(row / seqlen) * d + col];
    } else if (first(row)) {
        return 0.0;
    } else {
        return x[(row - 1u) * d + col];
    }
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint row = idx / d;
    uint col = idx % d;
    if (idx < bt * d && op == 0) {
        float m = mix[col];
        outp[idx] = m * x[idx] + (1.0 - m) * previous(row, col);
        if (cache == 1u && clean_row(row) && row % seqlen == seqlen - 1u) {
            carry_out[(row / seqlen) * d + col] = x[idx];
        }
    } else if (idx < bt * d) {
        float m = mix[col];
        float dout = outp[idx];
        atomicAdd(dmix[col], (x[idx] - previous(row, col)) * dout);
        atomicAdd(dx[idx], m * dout);
        if (first(row) == false) {
            atomicAdd(dx[(row - 1u) * d + col], (1.0 - m) * dout);
        }
    }
}
