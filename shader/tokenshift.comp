#version 450
#extension GL_EXT_shader_atomic_float : require
// RWKV token-shift: mix each token with its previous token, per-channel weight.
//   out[b, t, c] = mix[c] * x[b, t, c] + (1 - mix[c]) * x[b, t-1, c]   (x[.,-1,.] = 0)
//   op 0 forward:  reads x, mix; writes out.
//   op 1 backward: reads x (input, untouched), mix, dout; writes dx (separate buffer,
//                  host-zeroed), accumulates dmix. dx and dmix use atomic add because
//                  the previous-token term is written by two source positions.
// One invocation per (b*t, c).
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer buf_x {
    float x[];
};
layout(std430, binding = 1) readonly buffer buf_mix {
    float mix[];
};
layout(std430, binding = 2) buffer buf_out {
    float outp[];
};
layout(std430, binding = 3) buffer buf_dx {
    float dx[];
};
layout(std430, binding = 4) buffer buf_dmix {
    float dmix[];
};
layout(push_constant) uniform pc {
    uint bt;
    uint d;
    uint seqlen;
    uint op;
};

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= bt * d) {
        return;
    }
    uint row = idx / d;
    uint col = idx % d;
    uint t = row % seqlen;
    float m = mix[col];
    float cur = x[idx];
    float prev = (t == 0u) ? 0.0 : x[(row - 1u) * d + col];

    if (op == 0) {
        outp[idx] = m * cur + (1.0 - m) * prev;
    } else {
        float dout = outp[idx];
        atomicAdd(dmix[col], (cur - prev) * dout);
        atomicAdd(dx[idx], m * dout);
        if (t != 0u) {
            atomicAdd(dx[(row - 1u) * d + col], (1.0 - m) * dout);
        }
    }
}
