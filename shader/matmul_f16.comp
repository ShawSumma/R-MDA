#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer BA { float16_t A[]; };
layout(std430, binding = 1) readonly buffer BB { float16_t B[]; };
layout(std430, binding = 2) buffer BC { float C[]; };
layout(std430, binding = 3) readonly buffer BS { uint amax[]; };
layout(std430, binding = 4) writeonly buffer BH { float16_t H[]; };
layout(std430, binding = 5) readonly buffer BP { float P[]; };
layout(push_constant) uniform pc { uint m, n, k, sa, sb, ta, tb, store; float alpha, beta; };
const uint T = 16;

#define LOAD_A_N coopMatLoad(ma, A, row0 * k + kk, k, gl_CooperativeMatrixLayoutRowMajor)
#define LOAD_A_T coopMatLoad(ma, A, kk * m + row0, m, gl_CooperativeMatrixLayoutColumnMajor)
#define LOAD_B_N coopMatLoad(mb, B, kk * n + col0 + t * 16u, n, gl_CooperativeMatrixLayoutRowMajor)
#define LOAD_B_T coopMatLoad(mb, B, (col0 + t * 16u) * k + kk, k, gl_CooperativeMatrixLayoutColumnMajor)
#define MM_LOOP(LOAD_A, LOAD_B) \
    for (uint kk = 0; kk < k; kk = kk + T) { \
        coopmat<float16_t, gl_ScopeSubgroup, T, T, gl_MatrixUseA> ma; \
        LOAD_A; \
        for (uint t = 0; t < 4u; t = t + 1) { \
            coopmat<float16_t, gl_ScopeSubgroup, T, T, gl_MatrixUseB> mb; \
            LOAD_B; \
            ac[t] = coopMatMulAdd(ma, mb, ac[t]); \
        } \
    }

float slot_scale(uint s) {
    if (s == ~0u) {
        return 1.0;
    } else if (!(uintBitsToFloat(amax[s]) > 0.0) || isinf(uintBitsToFloat(amax[s]))) {
        return 1.0;
    } else {
        return exp2(141.0 - float((amax[s] >> 23) & 0xffu));
    }
}

void tile(uint row0, uint col0, bool mirror) {
    coopmat<float, gl_ScopeSubgroup, T, T, gl_MatrixUseAccumulator> ac[4];
    for (uint i = 0; i < 4u; i = i + 1) {
        ac[i] = coopmat<float, gl_ScopeSubgroup, T, T, gl_MatrixUseAccumulator>(0.0);
    }
    if (ta != 0u) {
        MM_LOOP(LOAD_A_T, LOAD_B_N)
    } else if (tb != 0u) {
        MM_LOOP(LOAD_A_N, LOAD_B_T)
    } else {
        MM_LOOP(LOAD_A_N, LOAD_B_N)
    }
    float s = alpha / (slot_scale(sa) * slot_scale(sb));
    for (uint t = 0; t < 4u; t = t + 1) {
        uint at = row0 * n + col0 + t * 16u;
        uint mt = (col0 + t * 16u) * n + row0;
        ac[t] = ac[t] * s;
        if (beta != 0.0) {
            coopmat<float, gl_ScopeSubgroup, T, T, gl_MatrixUseAccumulator> prev;
            coopMatLoad(prev, P, at, n, gl_CooperativeMatrixLayoutRowMajor);
            ac[t] = ac[t] + prev * beta;
        }
        if ((store & 1u) != 0u) {
            coopMatStore(ac[t], C, at, n, gl_CooperativeMatrixLayoutRowMajor);
        }
        if ((store & 1u) != 0u && mirror) {
            coopMatStore(ac[t], C, mt, n, gl_CooperativeMatrixLayoutColumnMajor);
        }
        if ((store & 2u) != 0u) {
            coopmat<float16_t, gl_ScopeSubgroup, T, T, gl_MatrixUseAccumulator> h = coopmat<float16_t, gl_ScopeSubgroup, T, T, gl_MatrixUseAccumulator>(ac[t]);
            coopMatStore(h, H, at, n, gl_CooperativeMatrixLayoutRowMajor);
            if (mirror) {
                coopMatStore(h, H, mt, n, gl_CooperativeMatrixLayoutColumnMajor);
            }
        }
    }
}

void main() {
    uint ty = gl_WorkGroupID.y;
    uint tx = gl_WorkGroupID.x;
    bool sym = (store & 4u) != 0u;
    if (sym == false || ty <= tx) {
        tile(ty * 64u + gl_SubgroupID * 16u, tx * 64u, sym && ty < tx);
    }
}
