#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_control_flow_attributes : require
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer BA { uvec4 A[]; };
layout(std430, binding = 1) readonly buffer BB { uvec4 B[]; };
layout(std430, binding = 2) buffer BC { float C[]; };
layout(std430, binding = 3) readonly buffer BS { uint amax[]; };
layout(std430, binding = 4) writeonly buffer BH { float16_t H[]; };
layout(std430, binding = 5) readonly buffer BP { float P[]; };
layout(push_constant) uniform pc { uint m, n, k, sa, sb, ta, tb, store; float alpha, beta; };
const uint T = 16u;
const uint BK = 32u;
const uint TILE = 64u;
const uint WIDE = 5u;
const uint LONG = 9u;
const uint STAGE = 320u;
shared uvec4 sA[2u * STAGE];
shared uvec4 sB[2u * STAGE];
uvec4 ra[2];
uvec4 rb[2];

uvec4 fetch_a(uint m0, uint k0, uint idx) {
    if (ta == 0u) {
        return A[((m0 + (idx >> 2)) * k + k0 + (idx & 3u) * 8u) >> 3];
    } else {
        return A[((k0 + (idx >> 3)) * m + m0 + (idx & 7u) * 8u) >> 3];
    }
}

uvec4 fetch_b(uint n0, uint k0, uint idx) {
    if (tb == 0u) {
        return B[((k0 + (idx >> 3)) * n + n0 + (idx & 7u) * 8u) >> 3];
    } else {
        return B[((n0 + (idx >> 2)) * k + k0 + (idx & 3u) * 8u) >> 3];
    }
}

uint slot_a(uint idx) {
    if (ta == 0u) {
        return (idx >> 2) * WIDE + (idx & 3u);
    } else {
        return (idx >> 3) * LONG + (idx & 7u);
    }
}

uint slot_b(uint idx) {
    if (tb == 0u) {
        return (idx >> 3) * LONG + (idx & 7u);
    } else {
        return (idx >> 2) * WIDE + (idx & 3u);
    }
}

void fetch(uint m0, uint n0, uint k0, uint tid) {
    [[unroll]] for (uint i = 0u; i < 2u; i = i + 1u) {
        ra[i] = fetch_a(m0, k0, tid + i * 128u);
        rb[i] = fetch_b(n0, k0, tid + i * 128u);
    }
}

void put(uint base, uint tid) {
    [[unroll]] for (uint i = 0u; i < 2u; i = i + 1u) {
        sA[base + slot_a(tid + i * 128u)] = ra[i];
        sB[base + slot_b(tid + i * 128u)] = rb[i];
    }
}

float slot_scale(uint s) {
    if (s == ~0u) {
        return 1.0;
    } else if (!(uintBitsToFloat(amax[s]) > 0.0) || isinf(uintBitsToFloat(amax[s]))) {
        return 1.0;
    } else {
        return exp2(141.0 - float((amax[s] >> 23) & 0xffu));
    }
}

void tile(uint m0, uint n0, bool mirror) {
    uint tid = gl_LocalInvocationID.x;
    uint sr = (gl_SubgroupID & 1u) * 32u;
    uint sc = (gl_SubgroupID >> 1) * 32u;
    coopmat<float, gl_ScopeSubgroup, T, T, gl_MatrixUseAccumulator> ac[2][2];
    [[unroll]] for (uint i = 0u; i < 2u; i = i + 1u) {
        [[unroll]] for (uint j = 0u; j < 2u; j = j + 1u) {
            ac[i][j] = coopmat<float, gl_ScopeSubgroup, T, T, gl_MatrixUseAccumulator>(0.0);
        }
    }
    uint steps = k / BK;
    fetch(m0, n0, 0u, tid);
    put(0u, tid);
    barrier();
    for (uint s = 0u; s < steps; s = s + 1u) {
        uint cur = (s & 1u) * STAGE;
        bool more = s + 1u < steps;
        if (more) {
            fetch(m0, n0, (s + 1u) * BK, tid);
        }
        [[unroll]] for (uint kk = 0u; kk < BK; kk = kk + T) {
            coopmat<float16_t, gl_ScopeSubgroup, T, T, gl_MatrixUseA> a[2];
            [[unroll]] for (uint i = 0u; i < 2u; i = i + 1u) {
                if (ta == 0u) {
                    coopMatLoad(a[i], sA, cur + (sr + i * T) * WIDE + kk / 8u, WIDE, gl_CooperativeMatrixLayoutRowMajor);
                } else {
                    coopMatLoad(a[i], sA, cur + kk * LONG + (sr + i * T) / 8u, LONG, gl_CooperativeMatrixLayoutColumnMajor);
                }
            }
            [[unroll]] for (uint t = 0u; t < 2u; t = t + 1u) {
                coopmat<float16_t, gl_ScopeSubgroup, T, T, gl_MatrixUseB> mb;
                if (tb == 0u) {
                    coopMatLoad(mb, sB, cur + kk * LONG + (sc + t * T) / 8u, LONG, gl_CooperativeMatrixLayoutRowMajor);
                } else {
                    coopMatLoad(mb, sB, cur + (sc + t * T) * WIDE + kk / 8u, WIDE, gl_CooperativeMatrixLayoutColumnMajor);
                }
                [[unroll]] for (uint i = 0u; i < 2u; i = i + 1u) {
                    ac[i][t] = coopMatMulAdd(a[i], mb, ac[i][t]);
                }
            }
        }
        if (more) {
            put(STAGE - cur, tid);
        }
        barrier();
    }
    uint row0 = m0 + sr;
    uint col0 = n0 + sc;
    float s = alpha / (slot_scale(sa) * slot_scale(sb));
    [[unroll]] for (uint i = 0u; i < 2u; i = i + 1u) {
        [[unroll]] for (uint t = 0u; t < 2u; t = t + 1u) {
            uint at = (row0 + i * 16u) * n + col0 + t * 16u;
            uint mt = (col0 + t * 16u) * n + row0 + i * 16u;
            ac[i][t] = ac[i][t] * s;
            if (beta != 0.0) {
                coopmat<float, gl_ScopeSubgroup, T, T, gl_MatrixUseAccumulator> prev;
                coopMatLoad(prev, P, at, n, gl_CooperativeMatrixLayoutRowMajor);
                ac[i][t] = ac[i][t] + prev * beta;
            }
            if ((store & 1u) != 0u) {
                coopMatStore(ac[i][t], C, at, n, gl_CooperativeMatrixLayoutRowMajor);
            }
            if ((store & 1u) != 0u && mirror) {
                coopMatStore(ac[i][t], C, mt, n, gl_CooperativeMatrixLayoutColumnMajor);
            }
            if ((store & 2u) != 0u) {
                coopmat<float16_t, gl_ScopeSubgroup, T, T, gl_MatrixUseAccumulator> h = coopmat<float16_t, gl_ScopeSubgroup, T, T, gl_MatrixUseAccumulator>(ac[i][t]);
                coopMatStore(h, H, at, n, gl_CooperativeMatrixLayoutRowMajor);
                if (mirror) {
                    coopMatStore(h, H, mt, n, gl_CooperativeMatrixLayoutColumnMajor);
                }
            }
        }
    }
}

void main() {
    uint ty = gl_WorkGroupID.y;
    uint tx = gl_WorkGroupID.x;
    bool sym = (store & 4u) != 0u;
    if (sym == false || ty <= tx) {
        tile(ty * TILE, tx * TILE, sym && ty < tx);
    }
}
