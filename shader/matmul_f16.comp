#version 450
// c[m, n] = a[m, k] @ b[k, n], using cooperative-matrix (matrix-core) ops.
// A and B are fp16; the accumulator and C are fp32 (the f16/f16/f32 config the
// hardware exposes). Each subgroup computes one 16x16 tile of C by stepping over
// K in 16-wide chunks. Dispatch one subgroup per tile: global = (n/16, m/16).
// On this UMA part the matmul is memory-bandwidth-bound, so a larger reuse tile did
// not help; the simple one-tile-per-subgroup kernel is kept for clarity.
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 32) in;

layout(std430, binding = 0) readonly buffer buf_a {
    float16_t a[];
};
layout(std430, binding = 1) readonly buffer buf_b {
    float16_t b[];
};
layout(std430, binding = 2) writeonly buffer buf_c {
    float c[];
};
layout(push_constant) uniform pc {
    uint m;
    uint n;
    uint k;
};

const uint TILE = 16;

void main() {
    uint row0 = gl_WorkGroupID.y * TILE;
    uint col0 = gl_WorkGroupID.x * TILE;

    coopmat<float, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseAccumulator> acc =
        coopmat<float, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseAccumulator>(0.0);

    for (uint kk = 0; kk < k; kk = kk + TILE) {
        coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseA> ma;
        coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseB> mb;
        coopMatLoad(ma, a, (row0 * k + kk), k, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(mb, b, (kk * n + col0), n, gl_CooperativeMatrixLayoutRowMajor);
        acc = coopMatMulAdd(ma, mb, acc);
    }
    coopMatStore(acc, c, (row0 * n + col0), n, gl_CooperativeMatrixLayoutRowMajor);
}
