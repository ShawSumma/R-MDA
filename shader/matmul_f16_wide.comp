#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer BA { float16_t A[]; };
layout(std430, binding = 1) readonly buffer BB { float16_t B[]; };
layout(std430, binding = 2) buffer BC { float C[]; };
layout(std430, binding = 3) readonly buffer BS { uint amax[]; };
layout(std430, binding = 4) writeonly buffer BH { float16_t H[]; };
layout(std430, binding = 5) readonly buffer BP { float P[]; };
layout(push_constant) uniform pc { uint m, n, k, sa, sb, ta, tb, store; float alpha, beta; };
const uint T = 16;

#define LOAD_A_N coopMatLoad(a[i], A, (row0 + i * 16u) * k + kk, k, gl_CooperativeMatrixLayoutRowMajor)
#define LOAD_A_T coopMatLoad(a[i], A, kk * m + row0 + i * 16u, m, gl_CooperativeMatrixLayoutColumnMajor)
#define LOAD_B_N coopMatLoad(mb, B, kk * n + col0 + t * 16u, n, gl_CooperativeMatrixLayoutRowMajor)
#define LOAD_B_T coopMatLoad(mb, B, (col0 + t * 16u) * k + kk, k, gl_CooperativeMatrixLayoutColumnMajor)
#define MM_LOOP(LOAD_A, LOAD_B) \
    for (uint kk = 0; kk < k; kk = kk + T) { \
        coopmat<float16_t, gl_ScopeSubgroup, T, T, gl_MatrixUseA> a[4]; \
        for (uint i = 0; i < 4u; i = i + 1) { \
            LOAD_A; \
        } \
        for (uint t = 0; t < 4u; t = t + 1) { \
            coopmat<float16_t, gl_ScopeSubgroup, T, T, gl_MatrixUseB> mb; \
            LOAD_B; \
            for (uint i = 0; i < 4u; i = i + 1) { \
                ac[i][t] = coopMatMulAdd(a[i], mb, ac[i][t]); \
            } \
        } \
    }

float slot_scale(uint s) {
    if (s == ~0u) {
        return 1.0;
    } else if (!(uintBitsToFloat(amax[s]) > 0.0) || isinf(uintBitsToFloat(amax[s]))) {
        return 1.0;
    } else {
        return exp2(141.0 - float((amax[s] >> 23) & 0xffu));
    }
}

void tile(uint row0, uint col0) {
    coopmat<float, gl_ScopeSubgroup, T, T, gl_MatrixUseAccumulator> ac[4][4];
    for (uint i = 0; i < 4u; i = i + 1) {
        for (uint j = 0; j < 4u; j = j + 1) {
            ac[i][j] = coopmat<float, gl_ScopeSubgroup, T, T, gl_MatrixUseAccumulator>(0.0);
        }
    }
    if (ta != 0u) {
        MM_LOOP(LOAD_A_T, LOAD_B_N)
    } else if (tb != 0u) {
        MM_LOOP(LOAD_A_N, LOAD_B_T)
    } else {
        MM_LOOP(LOAD_A_N, LOAD_B_N)
    }
    float s = alpha / (slot_scale(sa) * slot_scale(sb));
    for (uint i = 0; i < 4u; i = i + 1) {
        for (uint t = 0; t < 4u; t = t + 1) {
            uint at = (row0 + i * 16u) * n + col0 + t * 16u;
            ac[i][t] = ac[i][t] * s;
            if (beta != 0.0) {
                coopmat<float, gl_ScopeSubgroup, T, T, gl_MatrixUseAccumulator> prev;
                coopMatLoad(prev, P, at, n, gl_CooperativeMatrixLayoutRowMajor);
                ac[i][t] = ac[i][t] + prev * beta;
            }
            if ((store & 1u) != 0u) {
                coopMatStore(ac[i][t], C, at, n, gl_CooperativeMatrixLayoutRowMajor);
            }
            if ((store & 2u) != 0u) {
                coopmat<float16_t, gl_ScopeSubgroup, T, T, gl_MatrixUseAccumulator> h = coopmat<float16_t, gl_ScopeSubgroup, T, T, gl_MatrixUseAccumulator>(ac[i][t]);
                coopMatStore(h, H, at, n, gl_CooperativeMatrixLayoutRowMajor);
            }
        }
    }
}

void main() {
    uint row0 = gl_WorkGroupID.y * 128u + (gl_SubgroupID & 1u) * 64u;
    uint col0 = gl_WorkGroupID.x * 128u + (gl_SubgroupID >> 1) * 64u;
    if (row0 < m && col0 < n) {
        tile(row0, col0);
    }
}
