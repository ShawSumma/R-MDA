#version 450
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer B0 { float x[]; };
layout(std430, binding = 1) readonly buffer B1 { float w[]; };
layout(std430, binding = 2) writeonly buffer B2 { float y[]; };
layout(push_constant) uniform pc {
    uint rows;
    uint ch;
    uint seqlen;
    uint k;
    uint dil;
    uint in_stride;
    uint in_off;
    uint w_off;
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < rows * ch) {
        uint r = i / ch;
        uint c = i % ch;
        uint p = r % seqlen;
        float acc = 0.0;
        for (uint j = 0u; j < k; j += 1u) {
            uint back = dil * (k - 1u - j);
            if (back <= p) {
                acc += w[w_off + c * k + j] * x[(r - back) * in_stride + in_off + c];
            }
        }
        y[i] = acc / (1.0 + exp(-acc));
    }
}
