#version 450
#extension GL_EXT_control_flow_attributes : require
#extension GL_KHR_shader_subgroup_clustered : require
layout(local_size_x = 256) in;

const uint CH = 4u;

layout(std430,binding=0) readonly  buffer BH  { float H[]; };
layout(std430,binding=1) readonly  buffer BSP { float Sprev[]; };
layout(std430,binding=2) readonly  buffer BdO { float dO[]; };
layout(std430,binding=3) writeonly buffer BD  { float D[]; };
layout(std430,binding=4) buffer BdB { float Dbst[]; };
layout(std430,binding=5) readonly  buffer BK  { float SK[]; };
layout(push_constant) uniform P { uint Bsz, Hd, T, DH, dir, blk, nclean, seq0, split, sec; };

shared vec4 hv[CH][64];
shared vec4 hu[CH][64];
shared float dsks[2][64];

uint step_row(uint base, uint tf) {
    if (dir == 0u) {
        return base + tf*64u;
    } else {
        return base + (T - 1u - tf)*64u;
    }
}

uint block_slot(uint seq, uint h, uint t) {
    uint c = seq;
    if (seq >= nclean) {
        c = seq - nclean;
    }
    return ((c*Hd + h)*(T/blk) + t/blk)*4096u;
}

uint fidx(uint i, uint e) {
    return (i >> 2)*256u + e*4u + (i & 3u);
}

float load_vec(uint s, uint lrow) {
    if (s < 6u) {
        return H[s*sec + lrow];
    } else if (s == 6u) {
        return dO[lrow];
    } else {
        return SK[lrow];
    }
}

void run(uint bh, uint seg) {
    uint lid = gl_LocalInvocationID.x;
    uint u = lid >> 2;
    uint p = lid & 3u;
    uint lj = lid >> 6;
    uint lx = lid & 63u;
    uint base = bh*T*64u;
    uint nc = T / CH;
    uint cps = nc / split;
    uint cbase = bh*nc*4096u;
    uint seq = bh / Hd;
    uint h = bh % Hd;
    bool noisy = blk > 0u && seq >= nclean;
    bool clean = blk > 0u && seq < nclean;

    float Ps[CH][16];
    float dA[16];
    float dB[16];
    [[unroll]] for (uint q = 0; q < 16u; q += 1u) {
        dA[q] = 0.0;
        dB[q] = 0.0;
    }

    float pre[8];
    float preS[16];
    {
        uint c = (seg + 1u)*cps - 1u;
        uint lrow = step_row(base, c*CH + lj) + lx;
        [[unroll]] for (uint s = 0; s < 8u; s += 1u) pre[s] = load_vec(s, lrow);
        [[unroll]] for (uint q = 0; q < 16u; q += 1u) preS[q] = Sprev[cbase + c*4096u + fidx(u, p + 4u*q)];
    }

    for (uint ci = 0; ci < cps; ci += 1u) {
        uint c = (seg + 1u)*cps - 1u - ci;
        barrier();
        hv[lj][lx] = vec4(pre[0], pre[1], pre[3], pre[4]);
        hu[lj][lx] = vec4(pre[5], pre[2], pre[6], pre[7]);
        barrier();
        float S[16];
        [[unroll]] for (uint q = 0; q < 16u; q += 1u) S[q] = preS[q];
        if (ci + 1u < cps) {
            uint lrow = step_row(base, (c - 1u)*CH + lj) + lx;
            [[unroll]] for (uint s = 0; s < 8u; s += 1u) pre[s] = load_vec(s, lrow);
            [[unroll]] for (uint q = 0; q < 16u; q += 1u) preS[q] = Sprev[cbase + (c - 1u)*4096u + fidx(u, p + 4u*q)];
        }

        [[unroll]] for (uint j = 0; j < CH; j += 1u) {
            [[unroll]] for (uint q = 0; q < 16u; q += 1u) Ps[j][q] = S[q];
            if (j + 1u < CH) {
                vec4 gi = hv[j][u];
                float aki = hu[j][u].x*gi.x;
                [[unroll]] for (uint q = 0; q < 16u; q += 1u) {
                    vec4 ge = hu[j][p + 4u*q];
                    S[q] = gi.w*S[q] - aki*ge.w + gi.y*ge.y;
                }
            }
        }

        [[unroll]] for (uint jj = 0; jj < CH; jj += 1u) {
            uint j = CH - 1u - jj;
            uint tf = c*CH + j;
            uint row = step_row(base, tf);

            vec4 gu = hv[j][u];
            vec4 hl = hu[j][u];
            float doe = hl.z;
            float dvp = 0.0;
            float nskp = 0.0;
            [[unroll]] for (uint q = 0; q < 16u; q += 1u) {
                vec4 gi = hv[j][p + 4u*q];
                float ai = hu[j][p + 4u*q].x;
                dA[q] += gi.z*doe;
                dvp += dA[q]*gi.y;
                nskp += dA[q]*ai*gi.x;
                dA[q] = gi.w*dA[q];
            }
            float dve = subgroupClusteredAdd(dvp, 4u);
            float dsk = -subgroupClusteredAdd(nskp, 4u);
            if (p == 0u) {
                dsks[j & 1u][u] = dsk;
                D[2u*sec + row + u] = dve;
            }
            [[unroll]] for (uint q = 0; q < 16u; q += 1u) {
                dA[q] += hv[j][p + 4u*q].x*dsk;
            }

            float wi = gu.w;
            float ki = gu.x;
            float ai = hl.x;
            float kti = gu.y;
            float ri = gu.z;
            vec4 x = vec4(0.0);
            [[unroll]] for (uint q = 0; q < 16u; q += 1u) {
                vec4 ge = hu[j][p + 4u*q];
                float dov = ge.z;
                float ske = ge.w;
                float ve = ge.y;
                float st = wi*Ps[j][q] - ai*ki*ske + kti*ve;
                dB[q] += ri*dov;
                x += vec4(st*dov, dB[q]*Ps[j][q], dB[q]*ve, dB[q]*ske);
            }
            x = subgroupClusteredAdd(x, 4u);
            barrier();
            float yp = 0.0;
            [[unroll]] for (uint q = 0; q < 16u; q += 1u) {
                float dske = dsks[j & 1u][p + 4u*q];
                yp += dske*Ps[j][q];
                dB[q] = wi*dB[q] + ki*dske;
            }
            float y = subgroupClusteredAdd(yp, 4u);
            if (p == 0u) {
                D[row + u] = y - ai*x.w;
                D[sec + row + u] = x.z;
                D[3u*sec + row + u] = x.x;
                D[4u*sec + row + u] = x.y;
                D[5u*sec + row + u] = -ki*x.w;
            }

            if (noisy && tf % blk == 0u && dir == 0u) {
                uint sb = block_slot(seq, h, tf);
                [[unroll]] for (uint q = 0; q < 16u; q += 1u) Dbst[sb + q*256u + lid] = 0.5*dA[q];
            }
            if (noisy && tf % blk == 0u) {
                [[unroll]] for (uint q = 0; q < 16u; q += 1u) {
                    dA[q] = 0.0;
                    dB[q] = 0.0;
                }
            }
            if (clean && tf % blk == 0u && tf > 0u) {
                uint sb = block_slot(seq, h, tf);
                [[unroll]] for (uint q = 0; q < 16u; q += 1u) {
                    dA[q] += Dbst[sb + q*256u + lid];
                    dB[q] += Dbst[sb + fidx(u, p + 4u*q)];
                }
            }
        }
    }
}

void main(){
    uint bh = seq0*Hd + gl_WorkGroupID.x / split;
    if (bh < Bsz*Hd) {
        run(bh, gl_WorkGroupID.x % split);
    }
}
