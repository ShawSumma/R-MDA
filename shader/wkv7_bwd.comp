#version 450
// RWKV-7 WKV backward. Reverse-time recurrence carrying dS (grad wrt state).
// Forward (per step t), with P = S_{t-1} and Sk = P^T k:
//   S_t[i,j] = w[j]*P[i,j] + a[i]*k[i]*(v[j] - Sk[j])
//   o_t[j]   = sum_i r[i]*S_t[i,j]
// We need: dK,dV,dR,dW,dA given dO. The forward saved every pre-step state P in
// `Sprev` ([T, DH*DH] per (b,h)); we read them rather than recompute.
// With ak = a*k and dS the grad wrt S_t (including this step's readout):
//   dR[i]  = sum_j S_t[i,j]*dO[j]
//   dW[j]  = sum_i dS[i,j]*P[i,j]
//   dV[j]  = sum_i dS[i,j]*ak[i]          dSk[j] = -dV[j]
//   dak[i] = sum_j dS[i,j]*(v[j] - Sk[j])
//   dA[i]  = dak[i]*k[i]                  dK[i]  = dak[i]*a[i] + sum_j dSk[j]*P[i,j]
//   dP[i,j] = w[j]*dS[i,j] + dSk[j]*k[i]
// Requires DH <= 64 (shared arrays); model_init checks the config.
layout(local_size_x = 64) in;

layout(std430,binding=0) readonly  buffer BK  { float K[]; };
layout(std430,binding=1) readonly  buffer BV  { float V[]; };
layout(std430,binding=2) readonly  buffer BR  { float R[]; };
layout(std430,binding=3) readonly  buffer BW  { float W[]; };
layout(std430,binding=4) readonly  buffer BA  { float A[]; };
layout(std430,binding=5) readonly  buffer BSP { float Sprev[]; }; // [T, DH*DH] saved fwd states (state BEFORE step t)
layout(std430,binding=6) readonly  buffer BdO { float dO[]; };
layout(std430,binding=7) writeonly buffer BdK { float dK[]; };
layout(std430,binding=8) writeonly buffer BdV { float dV[]; };
layout(std430,binding=9) writeonly buffer BdR { float dR[]; };
layout(std430,binding=10) writeonly buffer BdW{ float dW[]; };
layout(std430,binding=11) writeonly buffer BdA{ float dA[]; };
layout(push_constant) uniform P { uint Bsz, Hd, T, DH, dir; };

shared float dS[64*64];     // grad wrt current state S_t
shared float Sp[64*64];     // S_{t-1} for this step
shared float kk[64],vv[64],rr[64],ww[64],aa[64],Sk[64];
shared float dSk[64];       // grad wrt Sk[j]

void main(){
    uint bh=gl_WorkGroupID.x; if(bh>=Bsz*Hd) return;
    uint b=bh/Hd, h=bh%Hd, lid=gl_LocalInvocationID.x;
    uint DH2=DH*DH;
    uint base=(b*Hd+h)*T*DH;       // [T,DH] arrays
    uint sbase=(b*Hd+h)*T*DH2;     // [T,DH*DH] saved states

    for(uint i=lid;i<DH2;i+=64) dS[i]=0.0;
    barrier();

    for(uint ti=0; ti<T; ti++){
        // backward walks opposite to the forward: for a dir==0 (L->R) forward we
        // go reverse-time (T-1..0); for a dir==1 (R->L) forward we go forward-time.
        uint t = (dir==0) ? (T-1-ti) : ti;
        uint row = base + t*DH;
        for(uint d=lid;d<DH;d+=64){ kk[d]=K[row+d]; vv[d]=V[row+d];
            rr[d]=R[row+d]; ww[d]=W[row+d]; aa[d]=A[row+d]; }
        for(uint i=lid;i<DH2;i+=64) Sp[i]=Sprev[sbase+t*DH2+i];
        barrier();
        // Sk[j] = sum_i Sp[i,j]*k[i]
        for(uint j=lid;j<DH;j+=64){ float s=0; for(uint i=0;i<DH;i++) s+=Sp[i*DH+j]*kk[i]; Sk[j]=s; }
        barrier();
        // readout: dR[i] = sum_j S_t[i,j]*dO[j], with S_t rebuilt from Sp
        for(uint i=lid;i<DH;i+=64){ float dr=0; float ak=aa[i]*kk[i];
            for(uint j=0;j<DH;j++){ float St=ww[j]*Sp[i*DH+j]+ak*(vv[j]-Sk[j]);
                dr+=St*dO[row+j]; }
            dR[row+i]=dr; }
        barrier();
        for(uint idx=lid;idx<DH2;idx+=64){ uint i=idx/DH,j=idx%DH; dS[idx]+= rr[i]*dO[row+j]; }
        barrier();
        // column sums: dW, dV, dSk
        for(uint j=lid;j<DH;j+=64){ float dw=0, dv=0;
            for(uint i=0;i<DH;i++){ float g=dS[i*DH+j]; dw+=g*Sp[i*DH+j]; dv+=g*aa[i]*kk[i]; }
            dW[row+j]=dw; dV[row+j]=dv; dSk[j]=-dv; }
        barrier();
        // row sums: dA, dK
        for(uint i=lid;i<DH;i+=64){ float dak=0, dskp=0;
            for(uint j=0;j<DH;j++){ dak+=dS[i*DH+j]*(vv[j]-Sk[j]); dskp+=dSk[j]*Sp[i*DH+j]; }
            dA[row+i]=dak*kk[i]; dK[row+i]=dak*aa[i]+dskp; }
        barrier();
        // propagate to dS_prev: P appears via w[j]*P[i,j] and via Sk[j]=sum_i P[i,j]k[i].
        for(uint idx=lid;idx<DH2;idx+=64){ uint i=idx/DH,j=idx%DH;
            dS[idx] = ww[j]*dS[idx] + dSk[j]*kk[i]; }
        barrier();
    }
}
