#version 450
// cast a buffer of n fp32 values to fp16 (op 0) or fp16 back to fp32 (op 1).
// used to feed the cooperative-matrix matmul, which wants fp16 inputs, while the
// rest of the pipeline stays fp32.
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer buf_src_f32 {
    float src_f32[];
};
layout(std430, binding = 1) buffer buf_dst_f16 {
    float16_t dst_f16[];
};
layout(std430, binding = 2) readonly buffer buf_src_f16 {
    float16_t src_f16[];
};
layout(std430, binding = 3) buffer buf_dst_f32 {
    float dst_f32[];
};
layout(push_constant) uniform pc {
    uint n;
    uint op;
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= n) {
        return;
    }
    if (op == 0u) {
        dst_f16[i] = float16_t(src_f32[i]);
    } else {
        dst_f32[i] = float(src_f16[i]);
    }
}
