#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer buf_logits {
    float logits[];
};
layout(std430, binding = 1) readonly buffer buf_target {
    uint target[];
};
layout(std430, binding = 2) readonly buffer buf_mask {
    float mask[];
};
layout(std430, binding = 3) readonly buffer buf_weight {
    float weight[];
};
layout(std430, binding = 4) buffer buf_loss {
    float loss[];
};
layout(std430, binding = 5) readonly buffer buf_opt {
    float lr;
    float bc1;
    float bc2;
    float norm;
    float scale;
    float gmul;
};
layout(std430, binding = 6) buffer buf_logz {
    float logz[];
};
layout(std430, binding = 7) writeonly buffer buf_h {
    float16_t h[];
};
layout(std430, binding = 8) buffer buf_amax {
    uint amax[];
};
layout(std430, binding = 9) readonly buffer buf_tl {
    float tl[];
};
layout(std430, binding = 10) buffer buf_tz {
    float tz[];
};
layout(push_constant) uniform pc {
    uint rows;
    uint vocab;
    uint op;
    uint slot;
    uint soft;
    float teach;
};

shared float red[256];

float reduce_max(float v, uint lid) {
    red[lid] = v;
    barrier();
    for (uint o = 128; o > 0; o >>= 1) {
        if (lid < o) {
            red[lid] = max(red[lid], red[lid + o]);
        }
        barrier();
    }
    float r = red[0];
    barrier();
    return r;
}

float reduce_sum(float v, uint lid) {
    red[lid] = v;
    barrier();
    for (uint o = 128; o > 0; o >>= 1) {
        if (lid < o) {
            red[lid] += red[lid + o];
        }
        barrier();
    }
    float r = red[0];
    barrier();
    return r;
}

float slot_scale(uint s) {
    if (s == ~0u) {
        return 1.0;
    } else if (!(uintBitsToFloat(amax[s]) > 0.0) || isinf(uintBitsToFloat(amax[s]))) {
        return 1.0;
    } else {
        return exp2(141.0 - float((amax[s] >> 23) & 0xffu));
    }
}

float teacher_logz(uint base, uint lid) {
    float part_mx = -1e30;
    for (uint i = lid; i < vocab; i += 256) {
        part_mx = max(part_mx, tl[base + i]);
    }
    float mx = reduce_max(part_mx, lid);
    float part_se = 0.0;
    for (uint i = lid; i < vocab; i += 256) {
        part_se += exp(tl[base + i] - mx);
    }
    return mx + log(reduce_sum(part_se, lid));
}

void row_stats(uint row, uint lid) {
    uint base = row * vocab;
    uint tgt = target[row];
    float part_mx = -1e30;
    float part_mo = -1e30;
    for (uint i = lid; i < vocab; i += 256) {
        float l = logits[base + i];
        part_mx = max(part_mx, l);
        if (i != tgt) {
            part_mo = max(part_mo, l);
        }
    }
    float mx = reduce_max(part_mx, lid);
    float mo = reduce_max(part_mo, lid);
    float part_se = 0.0;
    for (uint i = lid; i < vocab; i += 256) {
        part_se += exp(logits[base + i] - mx);
    }
    float lz = mx + log(reduce_sum(part_se, lid));
    float tlz = 0.0;
    if (row < soft) {
        tlz = teacher_logz(base, lid);
    }
    if (lid == 0u) {
        float m = mask[row];
        float wt = weight[row];
        float lt = logits[base + tgt];
        logz[row] = lz;
        loss[row] = -m * wt * (lt - lz);
        float bound = max(1.0 - exp(lt - lz), exp(mo - lz));
        if (row < soft) {
            tz[row] = tlz;
            bound = 1.0;
        }
        if (slot != ~0u) {
            atomicMax(amax[slot], floatBitsToUint(abs(gmul * m * wt) * bound));
        }
    }
}

void row_grad(uint row, uint lid) {
    uint base = row * vocab;
    uint tgt = target[row];
    float lz = logz[row];
    float gm = gmul * mask[row] * weight[row];
    float s = slot_scale(slot);
    for (uint i = lid; i < vocab; i += 256) {
        float p = exp(logits[base + i] - lz);
        float g = gm * p;
        if (row < soft && i == tgt) {
            g = gm * (p - teach * exp(tl[base + i] - tz[row]) - (1.0 - teach));
        } else if (row < soft) {
            g = gm * (p - teach * exp(tl[base + i] - tz[row]));
        } else if (i == tgt) {
            g = gm * (p - 1.0);
        }
        if (op == 1u) {
            logits[base + i] = g;
        } else {
            h[base + i] = float16_t(g * s);
        }
    }
}

void main() {
    uint row = gl_WorkGroupID.x;
    if (row < rows && op == 0u) {
        row_stats(row, gl_LocalInvocationID.x);
    } else if (row < rows) {
        row_grad(row, gl_LocalInvocationID.x);
    }
}
