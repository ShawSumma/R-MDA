#version 450
// Partial sum-of-squares reduction for gradient-norm clipping. Each workgroup
// reduces its slice of `g[n]` into one partial in `out[wg]`. The host sums the
// (few) partials and computes the global norm -- avoids reading all 63M grads
// over slow write-combined memory. op 1: scale g[i] *= s (apply clip).
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer buf_g {
    float g[];
};
layout(std430, binding = 1) buffer buf_out {
    float partial[];
};
layout(push_constant) uniform pc {
    uint n;
    uint op;
    float scale;
};

shared float red[256];

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint lid = gl_LocalInvocationID.x;
    if (op == 1) {
        if (i < n) {
            g[i] *= scale;
        }
        return;
    }
    // op 0: sum of squares
    float v = (i < n) ? g[i] : 0.0;
    red[lid] = v * v;
    barrier();
    for (uint s = 128; s > 0; s >>= 1) {
        if (lid < s) {
            red[lid] += red[lid + s];
        }
        barrier();
    }
    if (lid == 0) {
        partial[gl_WorkGroupID.x] = red[0];
    }
}
