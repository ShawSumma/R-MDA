#version 450
// AdamW update for one parameter buffer. m, v are moment buffers (same length).
// Bias-correction denominators bc1, bc2 are computed on the host for the step.
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer buf_w {
    float w[];
};
layout(std430, binding = 1) readonly buffer buf_g {
    float g[];
};
layout(std430, binding = 2) buffer buf_m {
    float m[];
};
layout(std430, binding = 3) buffer buf_v {
    float v[];
};
layout(push_constant) uniform pc {
    uint n;
    float lr;
    float beta1;
    float beta2;
    float eps;
    float wd;
    float bc1;
    float bc2;
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= n) {
        return;
    }
    float gi = g[i];
    m[i] = beta1 * m[i] + (1.0 - beta1) * gi;
    v[i] = beta2 * v[i] + (1.0 - beta2) * gi * gi;
    float mh = m[i] / bc1;
    float vh = v[i] / bc2;
    w[i] = w[i] - lr * (mh / (sqrt(vh) + eps) + wd * w[i]);
}
