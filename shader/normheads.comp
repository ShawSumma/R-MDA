#version 450
// Per-head L2 normalization: each of n_vec contiguous vectors of length dh is
// scaled to unit norm in place. One workgroup per vector; the workgroup reduces
// the sum of squares in shared memory, then every thread scales its element. op 1
// also writes 1/||v|| per vector into inv (the backward needs that scale).
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer buf_v {
    float v[];
};
layout(std430, binding = 1) buffer buf_inv {
    float inv[];
};
layout(push_constant) uniform pc {
    uint n_vec;
    uint dh;
    uint op;
};

shared float partial[256];

void main() {
    uint vec = gl_WorkGroupID.x;
    if (vec >= n_vec) {
        return;
    }
    uint tid = gl_LocalInvocationID.x;
    uint base = vec * dh;

    float local = 0.0;
    for (uint e = tid; e < dh; e = e + gl_WorkGroupSize.x) {
        float x = v[base + e];
        local = local + x * x;
    }
    partial[tid] = local;
    barrier();

    for (uint stride = gl_WorkGroupSize.x / 2u; stride > 0u; stride = stride / 2u) {
        if (tid < stride) {
            partial[tid] = partial[tid] + partial[tid + stride];
        }
        barrier();
    }

    float scale = 1.0 / (sqrt(partial[0]) + 1e-6);
    if (op == 1u && tid == 0u) {
        inv[vec] = scale;
    }
    for (uint e = tid; e < dh; e = e + gl_WorkGroupSize.x) {
        v[base + e] = v[base + e] * scale;
    }
}
