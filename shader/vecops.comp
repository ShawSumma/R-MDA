#version 450
// Elementwise vector ops, GPU-side (host loops over mapped GPU memory are ~50000x
// slower than this). op 0: a[i] += b[i].  op 1: a[i] *= b[i].
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer buf_a {
    float a[];
};
layout(std430, binding = 1) readonly buffer buf_b {
    float b[];
};
layout(push_constant) uniform pc {
    uint n;
    uint op;
    float scale;
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= n) {
        return;
    }
    if (op == 0) {
        a[i] += b[i];
    } else if (op == 1) {
        a[i] *= b[i];
    } else if (op == 2) {
        a[i] = 1.0 / (1.0 + exp(-a[i]));   // op 2: in-place sigmoid (b unused)
    } else if (op == 3) {
        a[i] = 0.5 * (a[i] + b[i]);        // op 3: average (for bidirectional mean)
    } else if (op == 4) {
        a[i] *= 0.5;                       // op 4: in-place halve (b unused)
    } else if (op == 5) {
        a[i] = b[i];                       // op 5: copy b into a
    } else if (op == 6) {
        a[i] *= b[i] * (1.0 - b[i]);       // op 6: a *= sigmoid'(.) given b = sigmoid
    } else {
        a[i] *= scale;                     // op 7: a *= scale (b unused)
    }
}
