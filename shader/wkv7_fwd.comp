#version 450
// RWKV-7 WKV forward recurrence, one workgroup per (batch, head), sequential in t.
//   S_t = diag(w_t) S_{t-1} - a_t (k_t (S_{t-1}^T k_t)^T) + a_t (k_t v_t^T)
//   out_t = r_t^T S_t          (readout; the +r.x residual is added on the host side)
// State S is [DH x DH] (row i, col j). w,a,k,v,r are [DH] per (t).
// Layout per (b,h): k,v,r,w,a are [T, DH]; out is [T, DH]; we hold S in shared mem.
// direction: 0 = forward (t=0..T-1), 1 = backward (t=T-1..0).
layout(local_size_x = 256) in;  // threads cooperate on the [DH x DH] state per step

layout(std430,binding=0) readonly  buffer BK { float K[]; };
layout(std430,binding=1) readonly  buffer BV { float V[]; };
layout(std430,binding=2) readonly  buffer BR { float R[]; };
layout(std430,binding=3) readonly  buffer BW { float W[]; };  // decay in (0,1)
layout(std430,binding=4) readonly  buffer BA { float A[]; };  // in-context lr
layout(std430,binding=5) writeonly buffer BO { float O[]; };
layout(std430,binding=6) writeonly buffer BS { float Sout[]; }; // [T, DH*DH] pre-step states for bwd

layout(push_constant) uniform P { uint Bsz, Hd, T, DH, dir, save; };

shared float S[64*65];     // [DH x DH] state for this (b,h)
shared float kk[64], vv[64], rr[64], ww[64], aa[64];
shared float Sk[64];       // S^T k  (length DH)
shared float part[256];    // partial sums for the 4-way reductions

void main(){
    uint bh   = gl_WorkGroupID.x;        // flat (b*Hd + h)
    uint b    = bh / Hd;
    uint h    = bh % Hd;
    uint lid  = gl_LocalInvocationID.x;
    uint DHl  = DH;
    if(bh >= Bsz*Hd) return;

    // zero state rows owned by this thread (thread `lid` owns rows lid, lid+64, ...)
    for(uint i=lid;i<DHl*DHl;i+=gl_WorkGroupSize.x) S[(i>>6)*65u+(i&63u)]=0.0;
    barrier();

    // base offset into the per-(b,h) [T,DH] arrays
    uint base = (b*Hd + h) * T * DHl;

    for(uint ti=0; ti<T; ti++){
        uint t = (dir==0) ? ti : (T-1-ti);
        uint row = base + t*DHl;
        // load this step's vectors cooperatively
        for(uint d=lid; d<DHl; d+=gl_WorkGroupSize.x){
            kk[d]=K[row+d]; vv[d]=V[row+d];
            rr[d]=R[row+d]; ww[d]=W[row+d]; aa[d]=A[row+d];
        }
        barrier();
        // save the pre-update state S_{t-1} for the backward pass
        if(save==1){ uint sb=(b*Hd+h)*T*DHl*DHl + t*DHl*DHl;
            for(uint i=lid;i<DHl*DHl;i+=gl_WorkGroupSize.x) Sout[sb+i]=S[(i>>6)*65u+(i&63u)]; barrier(); }
        // Sk[j] = sum_i S[i,j]*k_i. 256 threads = 4 lanes per column j: lane g sums
        // its quarter of i, then the 4 partials combine. (DH=64, group=4.)
        {
            uint g = lid / DHl;            // lane 0..3
            uint j = lid % DHl;            // column 0..DH-1
            float s = 0.0;
            for(uint i=g; i<DHl; i+=4u) s += S[i*65u+j]*kk[i];
            part[lid] = s;
        }
        barrier();
        for(uint j=lid;j<DHl;j+=gl_WorkGroupSize.x){
            Sk[j] = part[j] + part[DHl+j] + part[2u*DHl+j] + part[3u*DHl+j];
        }
        barrier();
        float a_t = aa[0];   // scalar in-context lr (per-head scalar)
        // update: each thread updates its rows. S[i,j] = w_j*S[i,j] - a*k_i*Sk[j] + a*k_i*v_j
        for(uint idx=lid; idx<DHl*DHl; idx+=gl_WorkGroupSize.x){
            uint i=idx >> 6, j=idx & 63u;
            S[(idx>>6)*65u + (idx&63u)] = ww[j]*S[(idx>>6)*65u + (idx&63u)] - a_t*kk[i]*Sk[j] + a_t*kk[i]*vv[j];
        }
        barrier();
        // out_t[j] = sum_i r_i * S[i,j], same 4-lane-per-column reduction.
        {
            uint g = lid / DHl;
            uint j = lid % DHl;
            float o = 0.0;
            for(uint i=g; i<DHl; i+=4u) o += rr[i]*S[i*65u+j];
            part[lid] = o;
        }
        barrier();
        for(uint j=lid;j<DHl;j+=gl_WorkGroupSize.x){
            O[row+j] = part[j] + part[DHl+j] + part[2u*DHl+j] + part[3u*DHl+j];
        }
        barrier();
    }
}
