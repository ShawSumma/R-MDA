#version 450
#extension GL_EXT_shader_atomic_float : require
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer buf_x {
    float x[];
};
layout(std430, binding = 1) readonly buffer buf_ada {
    float ada[];
};
layout(std430, binding = 2) buffer buf_y {
    float y[];
};
layout(std430, binding = 3) writeonly buffer buf_dx {
    float dx[];
};
layout(std430, binding = 4) buffer buf_dada {
    float dada[];
};
layout(push_constant) uniform pc {
    uint bt;
    uint d;
    uint op;
    uint s_off;
    uint sh_off;
    uint rows_per;
    float scale;
};

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (op == 0u) {
        if (gid < bt * d) {
            uint col = gid % d;
            y[gid] = x[gid] * (1.0 + scale * ada[s_off + col]) + scale * ada[sh_off + col];
        }
    } else {
        uint col = gid % d;
        uint r0 = gid / d * rows_per;
        if (r0 < bt) {
            float sc = 1.0 + scale * ada[s_off + col];
            float gs = 0.0;
            float gh = 0.0;
            uint r1 = min(r0 + rows_per, bt);
            for (uint r = r0; r < r1; r = r + 1) {
                uint idx = r * d + col;
                float g = y[idx];
                dx[idx] = g * sc;
                gs += g * x[idx];
                gh += g;
            }
            atomicAdd(dada[s_off + col], scale * gs);
            atomicAdd(dada[sh_off + col], scale * gh);
        }
    }
}
