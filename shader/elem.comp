#version 450
// Elementwise ops over a flat array, op-selected. One invocation per element.
//   op 0: silu forward       y = x * sigmoid(x)        ; stash x in pre
//   op 1: silu backward      dx = dy * (sig + x*sig*(1-sig))   (pre holds x)
//   op 2: gelu forward       y = gelu(x)               ; stash x in pre
//   op 3: gelu backward      dx = dy * dgelu(x)        (pre holds x)
// Buffers: x (in/out), pre (stash/read), dy unused here (op uses x as dy on bwd).
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer buf_x {
    float x[];
};
layout(std430, binding = 1) buffer buf_pre {
    float pre[];
};
layout(push_constant) uniform pc {
    uint n;
    uint op;
};

float sigmoidf(float v) {
    return 1.0 / (1.0 + exp(-v));
}

float geluf(float v) {
    return 0.5 * v * (1.0 + tanh(0.7978845608 * (v + 0.044715 * v * v * v)));
}

float dgeluf(float v) {
    float t = tanh(0.7978845608 * (v + 0.044715 * v * v * v));
    float s = 0.7978845608 * (1.0 + 3.0 * 0.044715 * v * v);
    return 0.5 * (1.0 + t) + 0.5 * v * (1.0 - t * t) * s;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= n) {
        return;
    }
    if (op == 0) {
        float v = x[i];
        pre[i] = v;
        x[i] = v * sigmoidf(v);
    } else if (op == 1) {
        float v = pre[i];
        float sg = sigmoidf(v);
        x[i] = x[i] * (sg + v * sg * (1.0 - sg));
    } else if (op == 2) {
        float v = x[i];
        pre[i] = v;
        x[i] = geluf(v);
    } else {
        x[i] = x[i] * dgeluf(pre[i]);
    }
}
