#version 450
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer B0 { float x[]; };
layout(std430, binding = 1) readonly buffer B1 { float pre[]; };
layout(std430, binding = 2) buffer B2 { uint amax[]; };
layout(push_constant) uniform pc {
    uint n;
    uint op;
    uint slot;
};

shared float red[256];

void main() {
    uint lid = gl_LocalInvocationID.x;
    uint stride = gl_NumWorkGroups.x * 256u;
    float m = 0.0;
    for (uint i = gl_GlobalInvocationID.x; i < n; i += stride) {
        float r = max(pre[i], 0.0);
        float y = r * r;
        if (op == 1u) {
            y = x[i] * 2.0 * r;
        }
        x[i] = y;
        m = max(m, abs(y));
    }
    red[lid] = m;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1) {
        if (lid < s) {
            red[lid] = max(red[lid], red[lid + s]);
        }
        barrier();
    }
    if (lid == 0u) {
        atomicMax(amax[slot], floatBitsToUint(red[0]));
    }
}
