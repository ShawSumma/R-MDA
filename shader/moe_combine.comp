#version 450
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer B0 { float wt[]; };
layout(std430, binding = 1) readonly buffer B1 { uint slot[]; };
layout(std430, binding = 2) readonly buffer B2 { float y[]; };
layout(std430, binding = 3) readonly buffer B3 { float proj[]; };
layout(std430, binding = 4) readonly buffer B4 { float sh[]; };
layout(std430, binding = 5) readonly buffer B5 { float inj[]; };
layout(std430, binding = 6) buffer B6 { float h[]; };
layout(push_constant) uniform pc {
    uint rows;
    uint d;
    uint topk;
    uint pstride;
    uint sg_off;
    uint inj_stride;
    uint inj_off;
    uint hc;
};

float sigmoid(float v) {
    return 1.0 / (1.0 + exp(-v));
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < rows * d) {
        uint r = i / d;
        uint c = i % d;
        float acc = 0.0;
        for (uint j = 0u; j < topk; j += 1u) {
            acc += wt[r * topk + j] * y[slot[r * topk + j] * d + c];
        }
        acc += sigmoid(proj[r * pstride + sg_off]) * sh[i];
        for (uint s = 0u; s < hc; s += 1u) {
            h[r * hc * d + s * d + c] += acc * 2.0 * sigmoid(inj[r * inj_stride + inj_off + s] / float(hc));
        }
    }
}
