#version 450
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer B0 { uint w[]; };
layout(push_constant) uniform pc {
    uint n;
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < n) {
        uint u = w[i];
        w[i] = packHalf2x16(vec2(uintBitsToFloat(u << 16), uintBitsToFloat(u & 0xffff0000u)));
    }
}
